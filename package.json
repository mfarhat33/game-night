{
  "name": "sahra",
  "version": "0.1.0",
  "private": true,
  "description": "Sahra: a party game night in Arabic and English. Phones join a room with a code.",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-content.mjs",
    "build": "node scripts/gen-content.mjs && node scripts/build-client.mjs",
    "dev": "npm run build && wrangler dev",
    "typecheck": "node scripts/gen-content.mjs && tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run e2e",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.156.0"
  }
}
